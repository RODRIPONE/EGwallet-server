# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/egwallet
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-256-bits-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=egwallet-backend

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8100
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_MAX_AGE=3600

# Email Configuration (Optional)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-password
MAIL_FROM=noreply@egwallet.app

# Mobile Money Payment (Optional)
ORANGE_MONEY_API_KEY=your-key
MTN_MONEY_API_KEY=your-key

# Application Environment
APP_ENV=dev
APP_DEBUG=true